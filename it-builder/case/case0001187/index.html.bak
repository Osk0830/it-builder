    <meta charset="utf-8" />
    <meta name="format-detection" content="telephone=no" />
    <title>プロジェクト課題管理 &#8211; イットbuilder</title>
    <meta name="robots" content="max-image-preview:large" />

    <link rel="stylesheet" href="/it-builder/wp-includes/css/dist/block-library/style.min.css%3Fver=6.1.7.css" type="text/css" media="all" />
    <link rel="stylesheet" href="/it-builder/wp-includes/css/classic-themes.min.css%3Fver=1.css" type="text/css" media="all" />
