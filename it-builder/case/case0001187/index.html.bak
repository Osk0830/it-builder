    <link rel="alternate" />
    <link rel="alternate" />
    <meta name="description" content="イットbuilderは業務のお悩みを軽快かつスピーディに改善できるWeb業務アプリ作成ツールです。標準部品を組み合わせるだけで、日頃のお困りごとを解決する業務アプリを自分たちの手で簡単に作成できます。" />
    <script src="/it-builder/wp-content/themes/itbuilder-theme/resource/js/viewport.js"></script>
    <link rel="icon" href="/it-builder/wp-content/themes/itbuilder-theme/resource/sns/favicon.ico" />
    <link rel="shortcut icon" href="/it-builder/wp-content/themes/itbuilder-theme/resource/sns/favicon.ico" />
