    <div class="pageVisual--min" style="background-image: url(../../wp-content/themes/itbuilder-theme/resource/img/news_visual_bg.jpg)">
      <p class="pageVisual__en">
        <img src="/it-builder/wp-content/themes/itbuilder-theme/resource/img/title_news_white.png" alt="お知らせ" />
