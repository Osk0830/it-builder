{
  // =========================================================
  // Prettier 設定
  // - モノレポでプラグイン解決に失敗する場合は pluginSearchDirs を維持
  // =========================================================

  // --- メタ（スキーマ: VSCode の補完・バリデーションに有効） ---
  "$schema": "https://json.schemastore.org/prettierrc",

  // --- 基本整形（幅・インデント・改行） ---
  "printWidth": 100, // 1行の最大文字数（折返しの基準）
  "tabWidth": 2, // インデント幅（スペース数）
  "useTabs": false, // タブ: true=タブ / false=スペース
  "endOfLine": "lf", // 改行コード: "lf"（GitHub/LF統一）

  // --- 記号・クォート・カンマ・括弧 ---
  "semi": true, // 行末セミコロンを付ける
  "singleQuote": true, // 文字列リテラルをシングルクォートに
  "trailingComma": "all", // 末尾カンマ: 差分最小化のため "all" 推奨
  "bracketSpacing": true, // { foo: bar } のスペース有無
  "arrowParens": "always", // アロー関数引数1つでも () を付ける

  // --- JSX/HTML 表記ルール ---
  "jsxSingleQuote": false, // JSX属性はダブルクォート
  "bracketSameLine": false, // JSXの閉じカッコ「>」は改行（読みやすさ優先）
  "htmlWhitespaceSensitivity": "css", // 空白の扱いはCSS準拠
  "singleAttributePerLine": false, // trueで属性を1行1個に分割

  // --- テキスト・Markdown 系 ---
  "proseWrap": "preserve", // 折返し: preserveで既存改行を尊重（差分安定）

  // --- 埋め込み言語（HTML内のJS/CSS 等） ---
  "embeddedLanguageFormatting": "auto", // インラインコードも整形（基本ON）

  // --- プラグイン（Astro/Tailwind などの拡張） ---
  "plugins": [
    "prettier-plugin-astro", // .astro の整形サポート
    "prettier-plugin-tailwindcss" // Tailwind クラスの並び最適化
  ],
  "pluginSearchDirs": [
    "." // モノレポ等でのルート解決安定化。失敗時のみ残す
  ],

  // --- 拡張子ごとの上書き（overrides） ---
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "printWidth": 80, // 文章は読みやすい80桁に
        "proseWrap": "always" // 自動折返しで執筆体験を優先
      }
    },
    {
      "files": "*.astro",
      "options": {
        "singleAttributePerLine": true // コンポーネント属性は縦に並べて可読性UP
      }
    }
  ]
}
