{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 200,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "jsxSingleQuote": false,
  "bracketSameLine": false,
  "htmlWhitespaceSensitivity": "ignore",
  "singleAttributePerLine": false,
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "auto",

  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "pluginSearchDirs": ["."],

  "overrides": [
    { "files": "*.md", "options": { "printWidth": 80, "proseWrap": "always" } },
    { "files": "*.astro", "options": { "parser": "astro", "singleAttributePerLine": true } },
    { "files": "*.html", "options": { "parser": "html", "singleAttributePerLine": false, "printWidth": 1000 } }
  ]
}
